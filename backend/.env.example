# Mistral AI API Key
# Sign up and generate your free API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Model for general queries and conversations
# Free tier models:
# - mistral-small-latest (Recommended: fast, high quality, free-tier supported)
# - open-mistral-7b (Fast 7B model)
# - open-mixtral-8x7b (Sparse mixture of experts)
# - ministral-3b-latest
MISTRAL_MODEL=ministral-3b-latest

# Flask Backend Server Configuration
PORT=5000
